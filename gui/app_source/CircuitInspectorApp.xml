<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<MATLABApp schemaVersion='1.0.0' release='R2026b.0' minRelease='R2026b'>
    <UIFigure name='UIFigure'>
        <AutoResizeChildren>'off'</AutoResizeChildren>
        <Name>'Circuit Inspector'</Name>
        <Position>[100 100 1150 720]</Position>
        <Children>
            <GridLayout name='MainGrid'>
                <ColumnWidth>{'1x'}</ColumnWidth>
                <RowHeight>{'fit', 'fit', '1x', 150}</RowHeight>
                <RowSpacing>8</RowSpacing>
                <Children>
                    <GridLayout name='ToolbarGrid'>
                        <ColumnSpacing>8</ColumnSpacing>
                        <ColumnWidth>{'fit', 'fit', 'fit', '1x'}</ColumnWidth>
                        <Layout>
                            <Column>1</Column>
                            <Row>1</Row>
                        </Layout>
                        <Padding>[0 0 0 0]</Padding>
                        <RowHeight>{'fit'}</RowHeight>
                        <Children>
                            <Button name='SelectModelButton'>
                                <ButtonPushedFcn>SelectModelButtonPushed</ButtonPushedFcn>
                                <Layout>
                                    <Column>1</Column>
                                    <Row>1</Row>
                                </Layout>
                                <Text>'1. Select Model'</Text>
                            </Button>
                            <Button name='InspectButton'>
                                <ButtonPushedFcn>InspectButtonPushed</ButtonPushedFcn>
                                <Enable>'off'</Enable>
                                <Layout>
                                    <Column>2</Column>
                                    <Row>1</Row>
                                </Layout>
                                <Text>'2. Inspect'</Text>
                            </Button>
                            <Button name='ExportButton'>
                                <ButtonPushedFcn>ExportButtonPushed</ButtonPushedFcn>
                                <Enable>'off'</Enable>
                                <Layout>
                                    <Column>3</Column>
                                    <Row>1</Row>
                                </Layout>
                                <Text>'3. Export CSVs'</Text>
                            </Button>
                            <Label name='ModelPathLabel'>
                                <Layout>
                                    <Column>4</Column>
                                    <Row>1</Row>
                                </Layout>
                                <Text>'No model selected.'</Text>
                            </Label>
                        </Children>
                    </GridLayout>
                    <Label name='ClassificationLabel'>
                        <FontSize>14</FontSize>
                        <FontWeight>'bold'</FontWeight>
                        <Layout>
                            <Column>1</Column>
                            <Row>2</Row>
                        </Layout>
                        <Text>'Result: not inspected yet'</Text>
                    </Label>
                    <TabGroup name='ResultsTabGroup'>
                        <Layout>
                            <Column>1</Column>
                            <Row>3</Row>
                        </Layout>
                        <Children>
                            <Tab name='ComponentsTab'>
                                <AutoResizeChildren>'off'</AutoResizeChildren>
                                <Title>'Components'</Title>
                                <Children>
                                    <GridLayout name='ComponentsGrid'>
                                        <ColumnWidth>{'1x'}</ColumnWidth>
                                        <Padding>[4 4 4 4]</Padding>
                                        <RowHeight>{'1x'}</RowHeight>
                                        <Children>
                                            <Table name='ComponentsTable'>
                                                <Layout>
                                                    <Column>1</Column>
                                                    <Row>1</Row>
                                                </Layout>
                                            </Table>
                                        </Children>
                                    </GridLayout>
                                </Children>
                            </Tab>
                            <Tab name='PortsTab'>
                                <AutoResizeChildren>'off'</AutoResizeChildren>
                                <Title>'Ports'</Title>
                                <Children>
                                    <GridLayout name='PortsGrid'>
                                        <ColumnWidth>{'1x'}</ColumnWidth>
                                        <Padding>[4 4 4 4]</Padding>
                                        <RowHeight>{'1x'}</RowHeight>
                                        <Children>
                                            <Table name='PortsTable'>
                                                <Layout>
                                                    <Column>1</Column>
                                                    <Row>1</Row>
                                                </Layout>
                                            </Table>
                                        </Children>
                                    </GridLayout>
                                </Children>
                            </Tab>
                            <Tab name='NetsTab'>
                                <AutoResizeChildren>'off'</AutoResizeChildren>
                                <Title>'Nets'</Title>
                                <Children>
                                    <GridLayout name='NetsGrid'>
                                        <ColumnWidth>{'1x'}</ColumnWidth>
                                        <Padding>[4 4 4 4]</Padding>
                                        <RowHeight>{'1x'}</RowHeight>
                                        <Children>
                                            <Table name='NetsTable'>
                                                <Layout>
                                                    <Column>1</Column>
                                                    <Row>1</Row>
                                                </Layout>
                                            </Table>
                                        </Children>
                                    </GridLayout>
                                </Children>
                            </Tab>
                            <Tab name='NetlistTab'>
                                <AutoResizeChildren>'off'</AutoResizeChildren>
                                <Title>'Netlist'</Title>
                                <Children>
                                    <GridLayout name='NetlistGrid'>
                                        <ColumnWidth>{'1x'}</ColumnWidth>
                                        <Padding>[4 4 4 4]</Padding>
                                        <RowHeight>{'1x'}</RowHeight>
                                        <Children>
                                            <Table name='NetlistTable'>
                                                <Layout>
                                                    <Column>1</Column>
                                                    <Row>1</Row>
                                                </Layout>
                                            </Table>
                                        </Children>
                                    </GridLayout>
                                </Children>
                            </Tab>
                            <Tab name='WarningsTab'>
                                <AutoResizeChildren>'off'</AutoResizeChildren>
                                <Title>'Warnings'</Title>
                                <Children>
                                    <GridLayout name='WarningsGrid'>
                                        <ColumnWidth>{'1x'}</ColumnWidth>
                                        <Padding>[4 4 4 4]</Padding>
                                        <RowHeight>{'1x'}</RowHeight>
                                        <Children>
                                            <Table name='WarningsTable'>
                                                <Layout>
                                                    <Column>1</Column>
                                                    <Row>1</Row>
                                                </Layout>
                                            </Table>
                                        </Children>
                                    </GridLayout>
                                </Children>
                            </Tab>
                        </Children>
                    </TabGroup>
                    <TextArea name='MessagesTextArea'>
                        <Editable>'off'</Editable>
                        <Layout>
                            <Column>1</Column>
                            <Row>4</Row>
                        </Layout>
                    </TextArea>
                </Children>
            </GridLayout>
        </Children>
    </UIFigure>
    <RunConfiguration>
        <StartupFcn>startupFcn</StartupFcn>
    </RunConfiguration>
    <AppDetails>
        <Name>Circuit Inspector</Name>
        <Version>1.0</Version>
    </AppDetails>
    <InternalData>
        <AppId>839a2ffd-ef78-4d11-9a8f-912fb39e470e</AppId>
    </InternalData>
    <!-- Thumbnail is used by file previewers. To change how the thumbnail is captured or stored, use the App Details dialog box in App Designer. -->
    <Thumbnail autoCapture='true'>data:image/jpg;base64,</Thumbnail>
</MATLABApp>
